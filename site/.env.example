# Neon Postgres pooled connection string (preferred waitlist store)
# https://console.neon.tech → Project → Connection details → Pooled
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Fallback waitlist store (private GitHub JSONL)
# WAITLIST_GITHUB_REPO=owner/repo
# GITHUB_TOKEN=ghp_...

# Optional: send waitlist confirmation emails via Resend
# https://resend.com → API Keys → create key
# Verify a domain, then set RESEND_FROM to DigProg <hello@yourdomain.com>
# Until then, onboarding@resend.dev can only send to your Resend account email.
RESEND_API_KEY=
RESEND_FROM=DigProg <onboarding@resend.dev>

# Paddle Billing (sandbox)
# Server API key — never expose to the browser (scripts / webhooks only)
# PADDLE_API_KEY=pdl_sdbx_apikey_...
# PADDLE_ENV=sandbox
# Client-side token for Paddle.js (safe in Vite)
# VITE_PADDLE_CLIENT_TOKEN=test_...
# VITE_PADDLE_ENV=sandbox

